<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA2201/MA0012/S112: COM failures are mapped to HRESULTs through reserved
         exception types on purpose. S3877: Dispose enforces the HWND-owning thread.
         MA0099: CsWin32 flags enums have no named zero member. -->
    <NoWarn>$(NoWarn);CA2201;MA0012;S112;S3877;MA0099</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.363" PrivateAssets="all"/>
  </ItemGroup>
</Project>
